# Astro's toolchain needs two install scripts to produce a working build:
#   esbuild   - postinstall links the platform-specific binary Vite invokes
#   fsevents  - macOS-only optional native watcher used by `astro dev`
# Listing them here keeps `npm ci` non-interactive under npm's
# --strict-allow-scripts, without handing blanket script permission to the
# whole dependency tree.
allow-scripts[]=esbuild
allow-scripts[]=fsevents
allow-scripts-pin=false
